{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python demos/*)",
      "Bash(python3 demos/*)",
      "Bash(.venv/Scripts/python demos/*)",
      "Bash(.venv/bin/python demos/*)",
      "Bash(python -m venv .venv)",
      "Bash(python3 -m venv .venv)",
      "Bash(.venv/Scripts/python -m pip install -r requirements-langgraph.txt)",
      "Bash(.venv/bin/python -m pip install -r requirements-langgraph.txt)",
      "Bash(python --version)",
      "Bash(python3 --version)"
    ]
  }
}
