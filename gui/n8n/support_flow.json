    {
      "parameters": {
        "jsCode": "// 下書き作成（本番ではここを LLM ノードに置き換える）\n// 1回目はわざと根拠のない回答 → review で差し戻される\nreturn $input.all().map(item => {\n  const s = item.json;\n  const revisions = (s.revisions || 0) + 1;\n  const answer = revisions === 1\n    ? '返金できます。'\n    : `注文#${s.order_id}は購入${s.days}日以内のため返金可能です。`;\n  return { json: { ...s, revisions, answer } };\n});"
      },
