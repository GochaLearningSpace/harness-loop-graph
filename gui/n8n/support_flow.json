              "leftValue": "={{ $json.answer }}",
              "rightValue": "注文#",
              "operator": { "type": "string", "operation": "contains" }
            },
            {
              "id": "c-max-rev",
              "leftValue": "={{ $json.revisions }}",
              "rightValue": 3,
              "operator": { "type": "number", "operation": "gte" }
